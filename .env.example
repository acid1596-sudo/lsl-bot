# Copy this file to .env and fill in your values.
# .env is only ever read locally by the bot - it is never committed (see .gitignore).

# --- Provider priority chain ---
# Comma-separated, highest priority first. Each name must be "openai" or "anthropic".
# The bot tries these in order for every request, and only drops to Ollama once
# every entry here is in its cooldown window.
PRIMARY_PROVIDERS=openai,anthropic

# --- OpenAI (ChatGPT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Any current Claude model ID works, e.g. claude-sonnet-5 or claude-haiku-4-5
# for a lower cost per request than the default.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=1024

# --- Ollama (local fallback, used whenever every primary provider is cooling down) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
# How much of a conversation Ollama can see at once, in tokens. 8192 is the
# most llama3 supports. Lower it (e.g. 4096) if Ollama says it's out of
# memory; raise it for models with bigger windows.
OLLAMA_NUM_CTX=8192
# Seconds to wait for Ollama's reply. A PC without a strong graphics card
# can take minutes, especially on long conversations.
OLLAMA_TIMEOUT=600

# --- Failover tuning ---
# First cooldown applied the moment a provider reports it is out of usage, in seconds.
# If the provider's error includes a Retry-After header, that value is used instead.
DEFAULT_COOLDOWN_SECONDS=60
# Cooldown doubles (see BACKOFF_MULTIPLIER) each time a provider is still exhausted
# right after its previous cooldown expired, capped at this many seconds.
MAX_COOLDOWN_SECONDS=3600
BACKOFF_MULTIPLIER=2.0

# Where provider on/off-cooldown state is persisted between restarts.
# Set to an empty value to keep state in memory only.
STATE_FILE=./data/provider_state.json

# Where the chat page keeps conversations (one JSON file each).
CONVERSATIONS_DIR=./data/conversations

# --- Server ---
# 127.0.0.1 only accepts connections from this machine. Use 0.0.0.0 to let
# Second Life (or anything else on the network) reach it - and if you do,
# set BOT_SHARED_SECRET below, or anyone who finds the URL can spend your
# API usage.
HOST=127.0.0.1
PORT=8080

# When set, /chat and /status require an "X-Bot-Secret" header with this exact
# value (/health stays open). Use a long random string. start.cmd generates
# one for you.
BOT_SHARED_SECRET=

# --- Windows start.cmd only ---
# yes: open a free Cloudflare tunnel on every start, for Second Life or using
# the chat page from another device. no: this PC only. Empty: asked once.
PUBLIC_TUNNEL=
# no: don't create the lsl-bot shortcut on the desktop.
DESKTOP_SHORTCUT=
